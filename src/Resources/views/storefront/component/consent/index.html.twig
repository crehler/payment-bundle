{% set consent = page.extensions[constant('Crehler\\PaymentBundle\\Infrastructure\\Struct\\CheckoutConfirmPageExtensionStruct::API_ALIAS')].consent %}

{% if consent.requiresAcceptance %}
    {# Acceptance consent (e.g. gateway regulations): a required checkbox. #}
    <div class="form-check">
        <input type="checkbox"
               class="checkout-confirm-tos-checkbox form-check-input"
               id="consent"
               name="consent"
               required="required"
               form="confirmOrderForm">

        <label class="checkout-confirm-tos-label custom-control-label" for="consent">
            {# content carries the acceptance text + provider regulations link (trusted,
               set in the provider's ConsentProvider). Fall back to the title. #}
            {{ (consent.content ?: consent.title)|raw }}
        </label>
    </div>
{% else %}
    {# Informational disclosure (e.g. GDPR data-processing notice): must be shown,
       not ticked. One line — the notice's title — with "Read more" opening the full
       text in a modal, as PayNow's own plugins present it (PrestaShop, WT-1030).
       The modal header carries the generic heading: notice titles are full sentences. #}
    {% set consentModalId = 'crPaymentConsentModal' %}
    {% set consentHeading = "payment.consent.dataProcessingTitle"|trans %}

    <div class="cr-payment-consent-info">
        <p class="cr-payment-consent-summary text-muted small mb-0">
            {{ (consent.title ?: consentHeading)|raw }}
            {% if consent.content %}
                <a href="#{{ consentModalId }}"
                   class="cr-payment-consent-more"
                   data-bs-toggle="modal"
                   data-bs-target="#{{ consentModalId }}">{{ "payment.consent.readMore"|trans }}</a>
            {% endif %}
        </p>

        {% if consent.content %}
            {# The order form submits without JavaScript, and the notice is an information
               obligation — without JS the modal never opens, so the text stays reachable
               in a plain collapsible block. #}
            <noscript>
                <details class="cr-payment-consent-details small text-muted mt-1">
                    <summary>{{ "payment.consent.readMore"|trans }}</summary>
                    <div class="cr-payment-consent-body mt-2">
                        {{ consent.content|raw }}
                    </div>
                </details>
            </noscript>

            <div class="modal fade" id="{{ consentModalId }}" tabindex="-1" aria-labelledby="{{ consentModalId }}Label" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="{{ consentModalId }}Label">{{ consentHeading }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ "global.default.close"|trans|striptags }}"></button>
                        </div>
                        <div class="modal-body cr-payment-consent-body">
                            {% if consent.title %}
                                <p><strong>{{ consent.title|raw }}</strong></p>
                            {% endif %}
                            {{ consent.content|raw }}
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endif %}
