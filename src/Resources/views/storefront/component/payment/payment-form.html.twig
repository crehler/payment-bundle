{% sw_extends '@Storefront/storefront/component/payment/payment-form.html.twig' %}

{% block component_payment_form_list %}
    {{ parent() }}

    {# Card form section - rendered after all payment methods #}
    {% set checkoutBundleExt = page.extensions[constant('Crehler\\PaymentBundle\\Infrastructure\\Struct\\CheckoutConfirmPageExtensionStruct::API_ALIAS')] %}

    {# Find the card payment method that is currently selected #}
    {% set selectedCardPayment = null %}
    {% for payment in page.paymentMethods %}
        {% set crPaymentContract = payment.extensions[constant('Crehler\\PaymentBundle\\Infrastructure\\Extension\\PaymentMethodExtension::EXTENSION_NAME')] %}
        {% if crPaymentContract
            and crPaymentContract.type is same as(constant('Crehler\\PaymentBundle\\Domain\\Enum\\PaymentType::CARD'))
            and context.paymentMethod.id is same as(payment.id) %}
            {% set selectedCardPayment = payment %}
        {% endif %}
    {% endfor %}

    {# Show card form if embedCardForm is enabled and card payment is selected #}
    {% if checkoutBundleExt
        and checkoutBundleExt.embedCardForm
        and selectedCardPayment %}

        <div class="crehler-external-payment-form crehler-external-card-form">
            {#
              The provider's card form is rendered BY PATH, resolved server-side from
              CardFormTemplateProviderPort — not by overriding a Twig block here.

              This template must sw_extends the Storefront template at the same relative
              path as its own, and Shopware then flattens the inheritance chain: a plugin
              extending THIS file at that path gets resolved to the Storefront one, so a
              block override in the plugin never reached the output and the section
              rendered empty (WT-910). One shared path also caps the block approach at a
              single provider. Each provider now ships its form under its own namespace,
              so there is nothing to collide.
            #}
            {% if checkoutBundleExt.cardFormTemplate %}
                {% sw_include checkoutBundleExt.cardFormTemplate with {
                    selectedCardPayment: selectedCardPayment
                } %}
            {% endif %}

            {% block crehler_payment_method_card_form %}
                {# DEPRECATED — kept for one release so a provider that has not migrated to
                   CardFormTemplateProviderPort yet does not break. Never rendered from a
                   plugin override (see above); remove once all providers ship the port. #}
            {% endblock %}
        </div>
    {% endif %}
{% endblock %}
